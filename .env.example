# ==============================================================================
# ClusterMind Environment Configuration Template
# Copy this file to .env and populate with your local values.
# NEVER commit actual .env files, credentials, or private API keys to git.
# ==============================================================================

# --- AI & Gemini Configuration ---
# Required for AI incident root-cause investigations and blast-radius analysis.
# Obtain a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key

# Optional model override. Default is gemini-3.5-flash-lite.
# Other supported options: gemini-3.8-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Kubernetes Collector Configuration ---
# Path to your kubeconfig. Defaults to ~/.kube/config if unset.
KUBECONFIG=

# Restrict digital twin collection to a dedicated demo namespace.
# Leave empty or set to "all" for cluster-wide collection (local development).
CLUSTERMIND_NAMESPACE=demo

# Server port (default: 8080). Cloud Run dynamically supplies PORT.
CLUSTERMIND_PORT=8080
PORT=8080

# Logging verbosity: DEBUG | INFO | WARN | ERROR (default: INFO)
CLUSTERMIND_LOG_LEVEL=INFO

# --- Cloud Run & Remote GKE Deployment ---
# Used by cloudrundeploy.sh (requires an explicitly selected remote GKE target)
PROJECT_ID=
REGION=asia-northeast3
SERVICE=clustermind
KUBE_CONTEXT=
NAMESPACE=demo
